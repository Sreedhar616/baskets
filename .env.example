# ============================================================
#  D's Designs — Environment Variables
#  Copy this file to .env.local and fill in real values.
#  See setup.md for step-by-step instructions on getting each key.
#  NEVER commit .env.local — it holds your secrets.
# ============================================================

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key       # SERVER ONLY — never expose to the browser

# ---- Razorpay (Dashboard → Settings → API Keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret            # set when you create the webhook
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx          # same as RAZORPAY_KEY_ID (public)

# ---- Resend (order confirmation emails) ----
RESEND_API_KEY=your-resend-api-key
ORDER_FROM_EMAIL=orders@yourdomain.com                 # or onboarding@resend.dev while testing
OWNER_ALERT_EMAIL=youremail@example.com                # where new-order alerts are sent

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000             # use your Vercel/custom domain in production
